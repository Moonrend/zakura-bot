{
  "name": "zakura-bot",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "expo": "~57.0.23",
    "expo-constants": "~57.0.18",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-secure-store": "^57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-web-browser": "~57.0.3",
    "lucide-react-native": "^1.46.0",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.5",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "@types/react": "~19.2.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "lint": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "export:web": "expo export --platform web",
    "preview:web": "node scripts/serve-web.mjs",
    "test:web": "playwright test",
    "eas:build:android": "eas build -p android --profile preview",
    "eas:build:ios": "eas build -p ios --profile preview",
    "eas:build:all": "eas build -p all --profile preview",
    "eas:build:production": "eas build -p all --profile production",
    "prebuild:android": "expo prebuild --platform android --non-interactive"
  },
  "private": true,
  "description": "Zakura Bot — Expo chat client for the Zakura platform (Grok Bot–inspired UI)"
}
